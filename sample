#include "mbed.h"
#include "LK_Motor.h"
#include "CANManager.h"
#include "PID_Control.h"

CAN can1(PA_11, PA_12, 1000000);//上位マイコンとの通信
CAN can2(PB_5 , PB_6 , 1000000);//駆動用


UnbufferedSerial pc(USBTX, USBRX, 115200);  
LKMState state[4];//構造体
CANManager master_manager(can1);
CANManager motor_manager(can2);

LKMotor motor(can2, motor_manager, 4);

#define MAINLOOP_RATE 1ms
#define DT 0.001f

float kp=1.5f;
float ki=0.8f;
float kd=0.0f;
PID_Control<float>pids[4]={
    {kp, ki, kd, DT, -5000.0f, 5000.0f, 0.2f},
    {kp, ki, kd, DT, -5000.0f, 5000.0f, 0.2f},
    {kp, ki, kd, DT, -5000.0f, 5000.0f, 0.2f},
    {kp, ki, kd, DT, -5000.0f, 5000.0f, 0.2f}
};

void setting(){
    motor_manager.add_receiver(&motor);
    
    //forループで4輪分すべてに設定を適用する
    for (int i = 0; i < 4; i++) {
        pids[i].set_mode(PID_Control<float>::Mode::VELOCITY); 
        pids[i].set_lpf_enabled(false);                       
        pids[i].set_shortest_path(false);   
        pids[i].set_scurve_enabled(false); 
                                //max_jerk,max_accel   
        pids[i].set_scurve_params(50000.0f, 2500.0f);              
    }
}

float target_speed[4] = {0.0f};
int32_t speeds[4] = {0};
char key;
int main() {
    setting();
    CANMessage msg;

    while (true) {
        if (pc.readable()) {
            pc.read(&key, 1);
            switch (key) {
                case 'w': target_speed[0] = 100;  printf("speed=1500\n");
                          target_speed[1] = 100;  printf("speed=1500\n");
                          target_speed[2] = 100;  printf("speed=1500\n");
                          target_speed[3] = 100;  printf("speed=1500\n");
                          break;

                case 'q': target_speed[0] = 500;  printf("speed=120\n");    
                          target_speed[1] = 500;  printf("speed=120\n");    
                          target_speed[2] = 500;  printf("speed=120\n");    
                          target_speed[3] = 500;  printf("speed=120\n");
                          break;

                case 'e': target_speed[0] = -500; printf("speed=-500\n");
                          target_speed[1] = -500; printf("speed=-500\n");
                          target_speed[2] = -500; printf("speed=-500\n");
                          target_speed[3] = -500; printf("speed=-500\n");
                          break;

                case 's': target_speed[0] = 0;    printf("speed=0\n");
                          target_speed[1] = 0;    printf("speed=0\n");
                          target_speed[2] = 0;    printf("speed=0\n");
                          target_speed[3] = 0;    printf("speed=0\n");
                          break;
            }
        }
        if (can1.read(msg)) {
            motor.handle_message(msg);
        }
        
        motor.requestAll();

    for (int i = 0; i < 4; i++) {
        if (motor.get_state(i, state[i])) {
            float current_speed = (float)state[i].spd; 
            float output = pids[i].update(target_speed[i], current_speed);
            speeds[i] = (int32_t)output; 
    }
}
        // モーターに速度制御コマンドを送信
        motor.spd_controlAll(speeds);   //配列にしたやつ全部送信
        //motor.spd_control(0,speeds[0]); //idが裏のディップスイッチが0001のモーターに送信
        for (int i = 0; i < 4; i++) {
        printf("[M%d] t:%d v:%d tgt:%.0f cur:%.0f out:%d | ", 
            i, state[i].temp, state[i].volt, target_speed[i], (float)state[i].spd, speeds[i]);
        }
        printf("\r\n");
        ThisThread::sleep_for(MAINLOOP_RATE);
    }
}
